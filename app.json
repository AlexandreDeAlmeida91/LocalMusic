{
  "expo": {
    "name": "Peak Music",
    "slug": "local-music",
    "version": "1.7.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alexandre.localmusic",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "Peak Music",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.alexandre.localmusic"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Peak Music utilise tes photos uniquement pour personnaliser les pochettes de tes morceaux.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
