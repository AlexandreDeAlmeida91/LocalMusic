{
  "expo": {
    "name": "LocalMusic",
    "slug": "local-music",
    "version": "1.4.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alexandre.localmusic",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.alexandre.localmusic"
    },
    "plugins": [
      "expo-document-picker"
    ]
  }
}
