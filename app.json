{
  "expo": {
    "name": "Peak Music",
    "slug": "local-music",
    "version": "1.5.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alexandre.localmusic",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "Peak Music"
      }
    },
    "android": {
      "package": "com.alexandre.localmusic"
    },
    "plugins": [
      "expo-document-picker"
    ],
    "icon": "./assets/icon.png"
  }
}
